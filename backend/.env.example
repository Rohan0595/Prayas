# ─── OpenRouter ───────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_SITE_NAME=Omni Assistant

# ─── App ──────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-in-production

# ─── Model routing overrides (optional) ───────────────────────────────────────
MODEL_CODING=deepseek/deepseek-coder
MODEL_REASONING=anthropic/claude-3-sonnet
MODEL_DEFAULT=openai/gpt-4o-mini

# ─── RAG ──────────────────────────────────────────────────────────────────────
FAISS_INDEX_PATH=./faiss_index
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K_RESULTS=4

# ─── Optional: web search via SerpAPI ─────────────────────────────────────────
# SERPAPI_KEY=your-serpapi-key-here
